# Named commands for agent shells. Aliases do not expand in the non-interactive
# shells most coding agents use, so every helper is a function that behaves the
# same in Bash and Zsh. No helper shadows a native command.

# Read-only native Git with stable, non-paged output and no credential prompt.
agent_git() {
    GIT_PAGER=cat GIT_TERMINAL_PROMPT=0 command git --no-pager -c color.ui=false "$@"
}

# Literal ripgrep invocation insulated from host ripgrep configuration.
agent_rg() {
    RIPGREP_CONFIG_PATH=/dev/null command rg --no-config --color=never "$@"
}

# Quiet, redirect-following curl: no progress meter, errors still shown.
agent_curl() {
    command curl --silent --show-error --location "$@"
}

# Capability check (adapted from require_tool): print "tool<TAB>version<TAB>path".
# Exit 0 found (and new enough), 1 missing, 2 older than MIN_VERSION, 3 version
# unreadable while MIN_VERSION was required, 64 usage. Runs `TOOL --version`.
agent_require() {
    local _tool="${1-}" _min="${2-}" _path _version
    if [ -z "$_tool" ]; then
        printf 'usage: agent_require TOOL [MIN_VERSION]\n' >&2
        return 64
    fi
    _path=$(command -v -- "$_tool") || {
        printf 'agent_require: %s not found\n' "$_tool" >&2
        return 1
    }
    _version=$("$_path" --version 2>/dev/null | sed -n '/[0-9]/{s/^[^0-9]*\([0-9][0-9]*\(\.[0-9][0-9]*\)*\).*/\1/p;q;}')
    if [ -n "$_min" ]; then
        if [ -z "$_version" ]; then
            printf 'agent_require: cannot read the version of %s\n' "$_tool" >&2
            return 3
        fi
        if [ "$(printf '%s\n%s\n' "$_min" "$_version" | sort -V | head -n 1)" != "$_min" ]; then
            printf 'agent_require: %s %s found, %s or newer required\n' "$_tool" "$_version" "$_min" >&2
            return 2
        fi
    fi
    printf '%s\t%s\t%s\n' "$_tool" "${_version:-unknown}" "$_path"
}

# Print the first N lines (default 100) of stdin and, on stdout, say how many
# were left out. Use instead of a bare `head`, which truncates silently.
agent_head() {
    local _limit="${1:-100}" _shown=0 _total=0 _line
    case "$_limit" in '' | *[!0-9]*) printf 'usage: ... | agent_head [LINES]\n' >&2; return 64 ;; esac
    while IFS= read -r _line || [ -n "$_line" ]; do
        _total=$((_total + 1))
        if [ "$_shown" -lt "$_limit" ]; then
            printf '%s\n' "$_line"
            _shown=$((_shown + 1))
        fi
    done
    if [ "$_total" -gt "$_limit" ]; then
        printf 'agent_head: TRUNCATED, showed %s of %s lines\n' "$_shown" "$_total"
    fi
}

# Disk usage one level deep (adapted from the base plugin's `usage`).
agent_usage() { command du -h -d 1 -- "${1:-.}"; }

# Host facts as key=value lines (adapted from os-info/os-detect.sh and cpuinfo).
agent_os() {
    printf 'kernel=%s\narch=%s\ncpus=%s\n' "$(uname -sr)" "$(uname -m)" \
        "$(getconf _NPROCESSORS_ONLN 2>/dev/null || printf unknown)"
    if [ -r /proc/version ] && grep -qi microsoft /proc/version; then
        printf 'wsl=1\n'
    fi
    if [ -r /etc/os-release ]; then
        sed -n 's/^ID=\(.*\)/id=\1/p; s/^VERSION_ID=\(.*\)/version_id=\1/p; s/^VERSION_CODENAME=\(.*\)/codename=\1/p' /etc/os-release | tr -d '"'
    elif command -v sw_vers >/dev/null 2>&1; then
        printf 'id=macos\nversion_id=%s\n' "$(sw_vers -productVersion)"
    fi
}

# Local TCP ports that are listening, one per line, sorted (adapted from
# netstat_used_local_ports).
agent_ports() {
    if command -v ss >/dev/null 2>&1; then
        ss -Hltn | awk '{ n = split($4, a, ":"); print a[n] }' | sort -n | uniq
    elif command -v netstat >/dev/null 2>&1; then
        netstat -an | awk '/LISTEN/ { n = split($4, a, "[.:]"); print a[n] }' | sort -n | uniq
    else
        printf 'agent_ports: neither ss nor netstat found\n' >&2
        return 1
    fi
}

# First port >= START (default 20000) nobody listens on. Another process can
# still claim it before you bind, so bind immediately and handle failure.
agent_free_port() {
    local _used
    _used=$(agent_ports) || return 1
    printf '%s\n' "$_used" | awk -v start="${1:-20000}" '
        { used[$1] = 1 }
        END { for (p = start; p < 65536; p++) if (!(p in used)) { print p; exit 0 } exit 1 }'
}

# Pretty-print JSON from stdin or files without color; invalid input is an error.
agent_json() {
    if command -v jq >/dev/null 2>&1; then
        command jq --monochrome-output . "$@"
    else
        python3 -m json.tool "$@"
    fi
}

# One line per character: code point and the character, or its category for
# control (Cc), format (Cf) and space (Z) characters that are invisible.
agent_codepoints() {
    if [ $# -ne 1 ]; then
        printf 'usage: agent_codepoints STRING\n' >&2
        return 64
    fi
    perl -CSA -e 'for my $c (split //, $ARGV[0]) {
        my $t = $c =~ /\p{Cc}/ ? "Cc" : $c =~ /\p{Cf}/ ? "Cf" : $c =~ /\p{Z}/ ? "Z" : $c;
        printf "U+%04X\t%s\n", ord($c), $t }' -- "$1"
}

# `php -l` over every *.php below DIR (default .), skipping .git, vendor and
# node_modules. Prints only failures plus a summary naming the exclusions.
agent_php_lint() {
    local _dir="${1:-.}" _out _ok _bad
    if [ ! -d "$_dir" ]; then
        printf 'usage: agent_php_lint [DIR]\n' >&2
        return 64
    fi
    command -v php >/dev/null 2>&1 || { printf 'agent_php_lint: php not found\n' >&2; return 1; }
    _out=$(find "$_dir" \( -name .git -o -name vendor -o -name node_modules \) -prune -o \
        -type f -name '*.php' -exec php -d display_errors=1 -d log_errors=0 -l {} \; 2>&1)
    _ok=$(printf '%s\n' "$_out" | grep -c '^No syntax errors detected in ')
    _bad=$(printf '%s\n' "$_out" | grep -c '^Errors parsing ')
    printf '%s\n' "$_out" | grep -v '^No syntax errors detected in ' | grep -v '^$'
    printf 'agent_php_lint: %s ok, %s with errors (skipped: .git vendor node_modules)\n' "$_ok" "$_bad"
    [ "$_bad" -eq 0 ]
}

# Unpack tar(.gz/.bz2/.xz) or zip into a new or empty DEST. Never deletes the
# archive and refuses absolute or `..` entries (adapted from extract; the
# original removed archives and unpacked into the cwd).
agent_extract() {
    local _archive="${1-}" _dest="${2-}" _kind _listing
    if [ ! -f "$_archive" ] || [ -z "$_dest" ]; then
        printf 'usage: agent_extract ARCHIVE DEST\n' >&2
        return 64
    fi
    case "$_archive" in
        *.tar | *.tar.gz | *.tgz | *.tar.bz2 | *.tbz2 | *.tar.xz | *.txz) _kind=tar ;;
        *.zip) _kind=zip ;;
        *) printf 'agent_extract: unsupported archive type: %s\n' "$_archive" >&2; return 64 ;;
    esac
    if [ -e "$_dest" ] && { [ ! -d "$_dest" ] || [ -n "$(ls -A -- "$_dest")" ]; }; then
        printf 'agent_extract: destination must not exist or be an empty directory\n' >&2
        return 1
    fi
    if [ "$_kind" = zip ]; then
        command -v unzip >/dev/null 2>&1 || { printf 'agent_extract: unzip not found\n' >&2; return 1; }
        _listing=$(unzip -Z1 "$_archive") || return 1
    else
        _listing=$(tar -tf "$_archive") || return 1
    fi
    if printf '%s\n' "$_listing" | grep -Eq '(^/|(^|/)\.\.(/|$))'; then
        printf 'agent_extract: refusing archive with absolute or ".." entries\n' >&2
        return 2
    fi
    mkdir -p -- "$_dest" || return 1
    if [ "$_kind" = zip ]; then
        unzip -q -d "$_dest" "$_archive"
    else
        tar -xf "$_archive" -C "$_dest" --no-same-owner
    fi
}

# --- Repo orientation and navigation (from #61; adapted from voku/dotfiles) ---

# Print compact orientation only; inspect source and full diffs before decisions.
agent_context() {
    local _agent_root
    _agent_root=$(command git rev-parse --show-toplevel) || return $?
    printf 'Repository: %s\n\nGit status:\n' "$_agent_root"
    command git -C "$_agent_root" --no-pager -c color.ui=false status --short --branch || return $?
    printf '\nUnstaged summary:\n'
    command git -C "$_agent_root" --no-pager -c color.ui=false diff --stat --no-ext-diff --no-textconv || return $?
    printf '\nStaged summary:\n'
    command git -C "$_agent_root" --no-pager -c color.ui=false diff --cached --stat --no-ext-diff --no-textconv || return $?

    if [ -f "$_agent_root/composer.json" ]; then
        printf '\nPHP / Composer project:\n'
        if ! command -v jq >/dev/null 2>&1; then
            printf '%s\n' 'Cannot read composer.json: jq is not installed.' >&2
            return 127
        fi
        command jq -e 'type == "object"' "$_agent_root/composer.json" >/dev/null || return $?
        printf 'Package: '
        command jq -r '.name // "(not declared)"' "$_agent_root/composer.json" || return $?
        printf 'PHP constraint: '
        command jq -r '.require.php // ."require-dev".php // "(not declared)"' "$_agent_root/composer.json" || return $?
        printf 'Composer scripts:\n'
        command jq -r '(.scripts // {}) | to_entries[] | "  \(.key): \(.value | if type == "array" then join(" && ") else tostring end)"' "$_agent_root/composer.json" || return $?
        printf 'Project config files:\n'
        local _agent_file _agent_found _agent_tool
        _agent_found=0
        for _agent_file in AGENTS.md CLAUDE.md .editorconfig phpunit.xml phpunit.xml.dist phpstan.neon phpstan.neon.dist psalm.xml psalm.xml.dist Makefile; do
            if [ -f "$_agent_root/$_agent_file" ]; then
                printf '  %s\n' "$_agent_file"
                _agent_found=1
            fi
        done
        if [ -d "$_agent_root/.github/workflows" ]; then
            printf '  .github/workflows/\n'
            _agent_found=1
        fi
        [ "$_agent_found" -eq 1 ] || printf '  (none found)\n'
        printf 'Available executables:\n'
        for _agent_tool in php composer; do
            if command -v "$_agent_tool" >/dev/null 2>&1; then
                printf '  %s: %s\n' "$_agent_tool" "$(command -v "$_agent_tool")"
            else
                printf '  %s: unavailable\n' "$_agent_tool"
            fi
        done
        printf 'Installed project checks:\n'
        _agent_found=0
        for _agent_file in vendor/bin/phpunit vendor/bin/phpstan vendor/bin/psalm vendor/bin/php-cs-fixer vendor/bin/phpcs; do
            if [ -x "$_agent_root/$_agent_file" ]; then
                printf '  %s\n' "$_agent_file"
                _agent_found=1
            fi
        done
        [ "$_agent_found" -eq 1 ] || printf '  (none installed)\n'
        if [ "$_agent_found" -eq 1 ] && ! command -v php >/dev/null 2>&1; then
            printf '%s\n' '  Cannot run these checks: PHP is unavailable.'
        fi
    fi
}

# Move to the current repository root without changing the shell's other state.
agent_root() {
    local _agent_root
    _agent_root=$(command git rev-parse --show-toplevel) || return $?
    builtin cd -- "$_agent_root" || return $?
}

# Complete native Git patch output, with external diff drivers disabled.
agent_diff() {
    command git --no-pager -c color.ui=false diff --no-ext-diff --no-textconv "$@"
}

# Check whitespace/errors in both staged and unstaged patches.
agent_diff_check() {
    command git diff --check "$@" || return $?
    command git diff --cached --check "$@"
}

# Dotfile-style navigation helper, safe for spaces and leading dashes.
agent_mkcd() {
    [ "$#" -eq 1 ] || { printf '%s\n' 'Usage: agent_mkcd DIRECTORY' >&2; return 2; }
    command mkdir -p -- "$1" && builtin cd -- "$1" || return $?
}

# Native Git provenance with literal pathspecs; full output, no summarizing.
agent_history() { agent_git --literal-pathspecs log "$@"; }
agent_blame() { agent_git --literal-pathspecs blame --line-porcelain "$@"; }

# shellcheck source=.redpill/lib/deactivation.sh
. "$AGENT_DOTFILES_HOME/.redpill/lib/deactivation.sh"
