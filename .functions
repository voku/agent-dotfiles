# Owned namespace only; forward arguments and the executable status unchanged.
agent_dotfiles() { PYTHONDONTWRITEBYTECODE=1 command "$AGENT_DOTFILES_HOME/bin/agent-dotfiles" "$@"; }
agent_doctor() { agent_dotfiles doctor "$@"; }
agent_files() { agent_dotfiles files "$@"; }
agent_search() { agent_dotfiles search "$@"; }
agent_read() { agent_dotfiles read "$@"; }
agent_tracked() { agent_dotfiles tracked "$@"; }
agent_status() { agent_dotfiles git-status "$@"; }
agent_patch() { agent_dotfiles git-patch "$@"; }
agent_history() { command git --no-pager --literal-pathspecs -c color.ui=false log "$@"; }
agent_blame() { command git --no-pager --literal-pathspecs -c color.ui=false blame --line-porcelain "$@"; }
agent_deactivate() {
    unset AGENT_DOTFILES_HOME
    unset -f agent_dotfiles agent_doctor agent_files agent_search agent_read agent_tracked agent_status agent_patch agent_history agent_blame agent_deactivate
}
