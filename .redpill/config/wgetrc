# Opt-in wget defaults for agents. Never applied automatically: use
#   WGETRC=$AGENT_DOTFILES_HOME/.redpill/config/wgetrc wget URL
# Adapted from the human .wgetrc: bounded waits and visible server responses.
# Dropped on purpose: a spoofed browser user-agent, robots=off, follow_ftp.
timeout = 60
tries = 3
retry_connrefused = on
no_parent = on
server_response = on
